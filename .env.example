APP_NAME="Step Shine Works"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── DATABASE ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuci_sepatu1
DB_USERNAME=root
DB_PASSWORD=

# ── SESSION / QUEUE / CACHE ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database

# ── FILE STORAGE ─────────────────────────────────────────────────────────────
# Setelah deploy jalankan: php artisan storage:link
FILESYSTEM_DISK=public

# ── WHATSAPP (Fonnte) ────────────────────────────────────────────────────────
# Dapatkan token di https://fonnte.com
FONNTE_TOKEN=
FONNTE_TOKEN=2x9sb9KTeioFG9ibZaJk

# ── VITE ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
