APP_NAME="Step Shine Works"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── DATABASE ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuci_sepatu1
DB_USERNAME=root
DB_PASSWORD=

# ── SESSION / QUEUE / CACHE ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database

CACHE_STORE=database

# ── FILE STORAGE ─────────────────────────────────────────────────────────────
# Setelah deploy jalankan: php artisan storage:link
FILESYSTEM_DISK=public

# ── WHATSAPP (Wablas) ────────────────────────────────────────────────────────
# Dapatkan token di https://wablas.com → Dashboard → Token
# WABLAS_URL: sesuaikan dengan server (cek di dashboard Wablas)
WABLAS_TOKEN=d7062Qe9kUPUcH6odo8l9NRUVJhFMR6smZysLBnXsw5C0WberfANaFI
WABLAS_URL=https://smg.wablas.com
WABLAS_SECRET=E7zHMUgQ

# ── MAIL ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@stepshine.works"
MAIL_FROM_NAME="${APP_NAME}"

# ── SEEDER ───────────────────────────────────────────────────────────────────
# Password akun admin awal — WAJIB diganti setelah login pertama
SEED_ADMIN_PASSWORD=

# ── VITE ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
